<mxfile host="app.diagrams.net" type="device"><diagram id="08_activity_dang_ky_phan_cong" name="Hoạt động đăng ký và phân công có ngoại lệ"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1500" pageHeight="2100"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="s" value="" style="whiteSpace=wrap;html=0;fontSize=20;fontFamily=Arial;strokeColor=#334155;fillColor=#F8FAFC;ellipse;fillColor=#334155;" vertex="1" parent="1"><mxGeometry as="geometry" x="735" y="75" width="30" height="30" /></mxCell><mxCell id="input" value="Nhập số người đăng ký" style="whiteSpace=wrap;html=0;fontSize=20;fontFamily=Arial;strokeColor=#334155;fillColor=#F8FAFC;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="585" y="135" width="330" height="75" /></mxCell><mxCell id="count" value="Phân loại&#10;số người" style="whiteSpace=wrap;html=0;fontSize=20;fontFamily=Arial;strokeColor=#334155;fillColor=#F8FAFC;rhombus;" vertex="1" parent="1"><mxGeometry as="geometry" x="590" y="275" width="320" height="130" /></mxCell><mxCell id="bad" value="Từ chối theo QD01&#10;Yêu cầu quyết định nghiệp vụ" style="whiteSpace=wrap;html=0;fontSize=20;fontFamily=Arial;strokeColor=#334155;fillColor=#F8FAFC;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="295" width="390" height="100" /></mxCell><mxCell id="le" value="1–11 người: chọn chuyến mở&#10;Đăng ký và thanh toán vé" style="whiteSpace=wrap;html=0;fontSize=20;fontFamily=Arial;strokeColor=#334155;fillColor=#F8FAFC;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="290" y="500" width="420" height="105" /></mxCell><mxCell id="doan" value="Từ 13 người: lập phiếu đoàn&#10;Đặt cọc; đủ danh sách nếu bảo hiểm" style="whiteSpace=wrap;html=0;fontSize=20;fontFamily=Arial;strokeColor=#334155;fillColor=#F8FAFC;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="825" y="500" width="570" height="105" /></mxCell><mxCell id="rejectend" value="" style="whiteSpace=wrap;html=0;fontSize=20;fontFamily=Arial;strokeColor=#334155;fillColor=#F8FAFC;shape=doubleEllipse;fillColor=#334155;" vertex="1" parent="1"><mxGeometry as="geometry" x="210" y="450" width="30" height="30" /></mxCell><mxCell id="choose" value="NV điều hành chọn chuyến / đoàn&#10;HDV và thù lao tour" style="whiteSpace=wrap;html=0;fontSize=20;fontFamily=Arial;strokeColor=#334155;fillColor=#F8FAFC;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="510" y="720" width="480" height="105" /></mxCell><mxCell id="valid" value="Đối tượng&#10;hợp lệ?" style="whiteSpace=wrap;html=0;fontSize=20;fontFamily=Arial;strokeColor=#334155;fillColor=#F8FAFC;rhombus;" vertex="1" parent="1"><mxGeometry as="geometry" x="590" y="930" width="320" height="130" /></mxCell><mxCell id="targeterr" value="Báo lỗi đối tượng / dữ liệu&#10;Chọn lại chuyến hoặc đoàn" style="whiteSpace=wrap;html=0;fontSize=20;fontFamily=Arial;strokeColor=#334155;fillColor=#F8FAFC;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="1050" y="945" width="400" height="100" /></mxCell><mxCell id="overlap" value="HDV bị&#10;trùng lịch?" style="whiteSpace=wrap;html=0;fontSize=20;fontFamily=Arial;strokeColor=#334155;fillColor=#F8FAFC;rhombus;" vertex="1" parent="1"><mxGeometry as="geometry" x="590" y="1160" width="320" height="130" /></mxCell><mxCell id="conflict" value="Báo chồng chéo lịch&#10;Yêu cầu chọn lại HDV" style="whiteSpace=wrap;html=0;fontSize=20;fontFamily=Arial;strokeColor=#334155;fillColor=#F8FAFC;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="1050" y="1175" width="400" height="100" /></mxCell><mxCell id="save" value="Lưu PhanCongHDV&#10;Thông báo phân công thành công" style="whiteSpace=wrap;html=0;fontSize=20;fontFamily=Arial;strokeColor=#334155;fillColor=#F8FAFC;rounded=1;arcSize=15;" vertex="1" parent="1"><mxGeometry as="geometry" x="510" y="1420" width="480" height="100" /></mxCell><mxCell id="e" value="" style="whiteSpace=wrap;html=0;fontSize=20;fontFamily=Arial;strokeColor=#334155;fillColor=#F8FAFC;shape=doubleEllipse;fillColor=#334155;" vertex="1" parent="1"><mxGeometry as="geometry" x="735" y="1650" width="30" height="30" /></mxCell><mxCell id="n" value="Đối tượng hợp lệ: chuyến lẻ tồn tại và chưa có HDV; đoàn ở trạng thái Đã đăng ký.&#10;Trùng lịch: lịch cũ bắt đầu ≤ ngày kết thúc mới và kết thúc ≥ ngày bắt đầu mới.&#10;Các kiểm tra chi tiết số tiền, ngày và bảo hiểm thuộc luồng đăng ký tương ứng.&#10;Số người ≤ 0 là dữ liệu không hợp lệ và phải nhập lại trước phân loại." style="whiteSpace=wrap;html=0;fontSize=20;fontFamily=Arial;strokeColor=#334155;fillColor=#F8FAFC;text;strokeColor=none;fillColor=none;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="130" y="1790" width="1240" height="180" /></mxCell><mxCell id="edge0" value="" style="endArrow=open;endFill=0;html=0;fontSize=17;strokeColor=#334155;" edge="1" parent="1" source="s" target="input"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge1" value="" style="endArrow=open;endFill=0;html=0;fontSize=17;strokeColor=#334155;" edge="1" parent="1" source="input" target="count"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge2" value="[đúng 12]" style="endArrow=open;endFill=0;html=0;fontSize=17;strokeColor=#334155;" edge="1" parent="1" source="count" target="bad"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge3" value="[1 ≤ n &lt; 12]" style="endArrow=open;endFill=0;html=0;fontSize=17;strokeColor=#334155;" edge="1" parent="1" source="count" target="le"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="500" y="450" /></Array></mxGeometry></mxCell><mxCell id="edge4" value="[n &gt; 12]" style="endArrow=open;endFill=0;html=0;fontSize=17;strokeColor=#334155;" edge="1" parent="1" source="count" target="doan"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1110" y="450" /></Array></mxGeometry></mxCell><mxCell id="edge5" value="Không lập phiếu" style="endArrow=open;endFill=0;html=0;fontSize=17;strokeColor=#334155;" edge="1" parent="1" source="bad" target="rejectend"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge6" value="Đăng ký thành công" style="endArrow=open;endFill=0;html=0;fontSize=17;strokeColor=#334155;" edge="1" parent="1" source="le" target="choose"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="500" y="660" /><mxPoint x="750" y="660" /></Array></mxGeometry></mxCell><mxCell id="edge7" value="Đăng ký thành công" style="endArrow=open;endFill=0;html=0;fontSize=17;strokeColor=#334155;" edge="1" parent="1" source="doan" target="choose"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1110" y="660" /><mxPoint x="750" y="660" /></Array></mxGeometry></mxCell><mxCell id="edge8" value="" style="endArrow=open;endFill=0;html=0;fontSize=17;strokeColor=#334155;" edge="1" parent="1" source="choose" target="valid"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge9" value="[không]" style="endArrow=open;endFill=0;html=0;fontSize=17;strokeColor=#334155;" edge="1" parent="1" source="valid" target="targeterr"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge10" value="" style="endArrow=open;endFill=0;html=0;fontSize=17;strokeColor=#334155;" edge="1" parent="1" source="targeterr" target="choose"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1250" y="775" /></Array></mxGeometry></mxCell><mxCell id="edge11" value="[có]" style="endArrow=open;endFill=0;html=0;fontSize=17;strokeColor=#334155;" edge="1" parent="1" source="valid" target="overlap"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge12" value="[có]" style="endArrow=open;endFill=0;html=0;fontSize=17;strokeColor=#334155;" edge="1" parent="1" source="overlap" target="conflict"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id=