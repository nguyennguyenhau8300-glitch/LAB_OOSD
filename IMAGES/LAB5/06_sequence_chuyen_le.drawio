<mxfile host="app.diagrams.net" type="device"><diagram id="06_sequence_chuyen_le" name="Tuần tự tạo chuyến và đóng đăng ký"><mxGraphModel grid="1" page="1" pageWidth="1500" pageHeight="1600"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p0" value="NV điều hành" style="shape=umlLifeline;html=0;whiteSpace=wrap;fontSize=19;perimeter=lifelinePerimeter;size=65;" vertex="1" parent="1"><mxGeometry as="geometry" x="10.0" y="70" width="220" height="1480"/></mxCell><mxCell id="p1" value="FrmChuyenLe" style="shape=umlLifeline;html=0;whiteSpace=wrap;fontSize=19;perimeter=lifelinePerimeter;size=65;" vertex="1" parent="1"><mxGeometry as="geometry" x="430.0" y="70" width="220" height="1480"/></mxCell><mxCell id="p2" value="ChuyenLeService" style="shape=umlLifeline;html=0;whiteSpace=wrap;fontSize=19;perimeter=lifelinePerimeter;size=65;" vertex="1" parent="1"><mxGeometry as="geometry" x="850.0" y="70" width="220" height="1480"/></mxCell><mxCell id="p3" value="Db / SQL Server" style="shape=umlLifeline;html=0;whiteSpace=wrap;fontSize=19;perimeter=lifelinePerimeter;size=65;" vertex="1" parent="1"><mxGeometry as="geometry" x="1270.0" y="70" width="220" height="1480"/></mxCell><mxCell id="m0" value="Nhập tour, ngày đi, nơi đón&#10;Nhấn Tạo chuyến" style="html=0;endArrow=open;endFill=0;fontSize=17;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="120.0" y="245"/><mxPoint as="targetPoint" x="532.0" y="245"/></mxGeometry></mxCell><mxCell id="m1" value="ThemChuyen(ma, maTour,&#10;ngayDi, diaDiemDon)" style="html=0;endArrow=open;endFill=0;fontSize=17;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="548.0" y="340"/><mxPoint as="targetPoint" x="952.0" y="340"/></mxGeometry></mxCell><mxCell id="m2" value="Scalar: lấy SoNgay&#10;Tour tồn tại và DangMoBan = 1" style="html=0;endArrow=open;endFill=0;fontSize=17;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="968.0